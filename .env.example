# Copy to /etc/netznoe-p1-reader.env and restrict it to the service account.
# Never commit the real GUEK or MQTT password.
NETZNOE_P1_GUEK=00000000000000000000000000000000
NETZNOE_P1_SERIAL_PORT=/dev/ttyUSB0
NETZNOE_P1_SERIAL_BAUDRATE=2400
NETZNOE_P1_SERIAL_TIMEOUT_MS=1000

NETZNOE_P1_MQTT_HOST=mqtt.example.invalid
NETZNOE_P1_MQTT_PORT=1883
NETZNOE_P1_MQTT_USERNAME=meter-reader
NETZNOE_P1_MQTT_PASSWORD=replace-me
NETZNOE_P1_MQTT_TOPIC_PREFIX=netznoe/p1
NETZNOE_P1_MQTT_KEEPALIVE=60

# Use a stable identifier unique within the MQTT/Home Assistant installation.
NETZNOE_P1_DEVICE_ID=meter_main
NETZNOE_P1_DEVICE_NAME=Netz NÖ Smart Meter
NETZNOE_P1_HA_DISCOVERY_PREFIX=homeassistant

# TLS verifies server certificates by default. Optionally specify a private CA.
NETZNOE_P1_MQTT_TLS=false
# NETZNOE_P1_MQTT_TLS_CA_CERT=/etc/ssl/certs/private-mqtt-ca.pem
NETZNOE_P1_LOG_LEVEL=INFO
